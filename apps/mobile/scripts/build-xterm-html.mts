/**
 * Embeds xterm.js (UMD build + CSS) into a self-contained HTML string for the WebView, so the
 * terminal works offline. The page carries no colors: the app injects the theme as `window.__theme`
 * before the page loads (`injectedJavaScriptBeforeContentLoaded`) and calls `window.setTheme` on a
 * theme switch. Run: pnpm --filter @remote-harness/mobile xterm
 */
import { readFileSync, writeFileSync } from 'node:fs'
import { createRequire } from 'node:module'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const require = createRequire(import.meta.url)
const pkgDir = dirname(require.resolve('@xterm/xterm/package.json'))
const js = readFileSync(join(pkgDir, 'lib', 'xterm.js'), 'utf8')
const css = readFileSync(join(pkgDir, 'css', 'xterm.css'), 'utf8')

const html = `<!doctype html>
<html><head>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<style>${css}
html,body{margin:0;padding:0;height:100%;overflow:hidden}
#term{padding:4px}
</style>
</head><body><div id="term"></div>
<script>${js}</script>
<script>
(function(){
  var theme = window.__theme || {};
  function paint(){
    var background = theme.background || '';
    document.documentElement.style.background = background;
    document.body.style.background = background;
    var viewport = document.querySelector('.xterm-viewport');
    if (viewport) viewport.style.background = background;
  }
  var term = new Terminal({
    disableStdin: true, cursorBlink: false, convertEol: true, scrollback: 0, fontSize: 11,
    fontFamily: 'Menlo, monospace',
    theme: theme
  });
  term.open(document.getElementById('term'));
  paint();
  window.setTheme = function(next){
    theme = next || {};
    term.options.theme = theme;
    paint();
  };
  // Pick the font size that fits the pane width on the phone screen.
  function fit(cols){
    var width = window.innerWidth - 8;
    var size = Math.max(6, Math.min(14, Math.floor(width / (cols * 0.6) * 10) / 10));
    if (term.options.fontSize !== size) term.options.fontSize = size;
  }
  // The app computes what to write (frame-write.ts): the whole screen after a resize, otherwise only
  // the rows that changed, so most frames redraw a line or two instead of resetting the terminal.
  window.writeFrame = function(write){
    if (write.full) {
      fit(write.cols);
      if (term.cols !== write.cols || term.rows !== write.rows) term.resize(write.cols, write.rows);
      term.reset();
    }
    term.write(write.data);
  };
  window.ReactNativeWebView && window.ReactNativeWebView.postMessage('ready');
})();
</script></body></html>`

const out = join(
  dirname(fileURLToPath(import.meta.url)),
  '..',
  'src',
  'features',
  'terminal',
  'xterm-html.generated.ts',
)
writeFileSync(
  out,
  `// Generated by scripts/build-xterm-html.mts — do not edit.\nexport const XTERM_HTML = ${JSON.stringify(html)}\n`,
)
console.log(`✓ ${out} (${Math.round(html.length / 1024)} KB)`)
